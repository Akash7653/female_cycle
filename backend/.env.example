# Server environment variables
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.1rtgyax.mongodb.net/skylovecycle?appName=Cluster0

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
